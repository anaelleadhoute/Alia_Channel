# ─── Server ───────────────────────────────────────────────────────────
DOMAIN=alia-channel.com
SERVER_IP=                        # Fill after Hetzner setup

# ─── n8n ──────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=                     # Choose a strong password
N8N_ENCRYPTION_KEY=               # Random 32-char string

# ─── Anthropic (Claude Haiku) ─────────────────────────────────────────
ANTHROPIC_API_KEY=                # console.anthropic.com

# ─── Whapi.Cloud ──────────────────────────────────────────────────────
WHAPI_API_KEY=                    # From Whapi.Cloud dashboard
WHAPI_CHANNEL_ID=                 # Your channel ID
WHAPI_FR_GROUP_ID=                # AL.IA FR group ID
WHAPI_RU_GROUP_ID=                # AL.IA RU group ID

# ─── Instagram (Phase 7 - Meta Graph API, "API setup with Instagram login") ────
META_ACCESS_TOKEN=                # graph.instagram.com token for the IG account
META_IG_ACCOUNT_ID=               # From GET https://graph.instagram.com/me

# ─── Canva (Connect API — Autofill, for carousel generation) ──────────
CANVA_CLIENT_ID=                  # canva.com/developers -> your Integration
CANVA_CLIENT_SECRET=

# ─── Alerts ───────────────────────────────────────────────────────────
ALERT_EMAIL=                      # Your email for error alerts
TELEGRAM_BOT_TOKEN=               # Optional: Telegram alert bot
TELEGRAM_CHAT_ID=                 # Optional: your Telegram chat ID

# ─── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
SCRAPE_INTERVAL_HOURS=3

# ─── Admin API auth ─────────────────────────────────────────────────────
# Required by every /api/* route except the public contest/recommendation
# forms. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match dashboard/config.js on this server (see dashboard/config.example.js).
ADMIN_API_KEY=
